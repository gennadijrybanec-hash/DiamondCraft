<resources>
    <style name="Theme.DiamondCraft" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/diamond_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DiamondCraft.Main</item>
    </style>

    <style name="Theme.DiamondCraft.Main" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/diamond_status_bg</item>
        <item name="android:navigationBarColor">@color/diamond_status_bg</item>
        <item name="android:windowBackground">@color/diamond_splash_bg</item>
    </style>
</resources>
